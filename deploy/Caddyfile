{$SITE_ADDRESS} {
  encode zstd gzip

  basic_auth {
    {$BASIC_AUTH_USERNAME} {$BASIC_AUTH_HASH}
  }

  reverse_proxy app:3000

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "SAMEORIGIN"
  }

  log {
    output stdout
    format console
  }
}
