server {
    listen 80;
    server_name test.maimu.fun;

    # Docker's embedded DNS keeps the upstream valid after the app container is recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $test_platform_upstream http://test-platform:3000;

    # The application has no built-in login. Keep Basic Auth enabled for public access.
    auth_basic "Test Platform";
    auth_basic_user_file /etc/nginx/auth/test-platform.htpasswd;

    location / {
        proxy_pass $test_platform_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
}
